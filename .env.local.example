# Vercel Postgres connection. When you attach a Postgres store to this
# project in the Vercel dashboard, these are auto-injected into the
# project's env vars there — you only need to set them locally (via
# `vercel env pull .env.local` or by pasting from the dashboard) to run
# `npm run dev` against the real database.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Notion (read-only sync). Create an internal integration at
# notion.so/my-integrations with only "Read content" checked, then share
# each database with it (database "..." menu -> Connections). The two
# *_DATABASE_ID vars default to the known databases, so they're only
# needed if pointing at different ones.
NOTION_TOKEN=
NOTION_NETWORKING_DATABASE_ID=
NOTION_GOALS_TASKS_DATABASE_ID=
