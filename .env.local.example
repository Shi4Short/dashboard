# Vercel Postgres connection. When you attach a Postgres store to this
# project in the Vercel dashboard, these are auto-injected into the
# project's env vars there — you only need to set them locally (via
# `vercel env pull .env.local` or by pasting from the dashboard) to run
# `npm run dev` against the real database.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Notion (read-only sync of the "Art Direction Networking" database).
# Create an internal integration at notion.so/my-integrations with only
# "Read content" checked, then share the database with it (database "..."
# menu -> Connections). NOTION_NETWORKING_DATABASE_ID defaults to the known
# database, so it's only needed if you're pointing at a different one.
NOTION_TOKEN=
NOTION_NETWORKING_DATABASE_ID=
